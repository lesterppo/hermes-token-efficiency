#!/bin/bash
# caveman — toggle caveman token-compression mode for Hermes Agent
#
# Usage:
#   caveman on [lite|full|ultra|wenyan-lite|wenyan-full|wenyan-ultra]   Activate (default: full)
#   caveman off                     Deactivate caveman mode
#   caveman status                  Show current status

MARKER="$HOME/.hermes/.caveman_active"
LEVEL_MARKER="$HOME/.hermes/.caveman_level"

VALID_LEVELS="lite full ultra wenyan-lite wenyan-full wenyan-ultra"

case "${1:-status}" in
    on)
        LEVEL="${2:-full}"
        case "$LEVEL" in
            lite|full|ultra|wenyan-lite|wenyan-full|wenyan-ultra|l|f|u|wl|wf|wu) ;;
            *) echo "Invalid level: $LEVEL. Use: $VALID_LEVELS"; exit 1 ;;
        esac
        # Expand short aliases
        case "$LEVEL" in
            l) LEVEL="lite" ;;
            f) LEVEL="full" ;;
            u) LEVEL="ultra" ;;
            wl) LEVEL="wenyan-lite" ;;
            wf) LEVEL="wenyan-full" ;;
            wu) LEVEL="wenyan-ultra" ;;
        esac
        echo "$LEVEL" > "$LEVEL_MARKER"
        touch "$MARKER"
        echo "Caveman mode: ON ($LEVEL)"
        echo "Applies immediately (middleware re-reads markers per LLM call) — no restart needed."
        ;;
    off)
        rm -f "$MARKER" "$LEVEL_MARKER"
        echo "Caveman mode: OFF"
        echo "Applies immediately (middleware strips injected rules) — no restart needed."
        ;;
    status)
        if [ -f "$MARKER" ]; then
            LEVEL=$(cat "$LEVEL_MARKER" 2>/dev/null || echo "full")
            echo "Caveman mode: ON ($LEVEL)"
        else
            echo "Caveman mode: OFF"
        fi
        ;;
    *)
        echo "Usage: caveman on [lite|full|ultra|wenyan-lite|wenyan-full|wenyan-ultra] | off | status"
        exit 1
        ;;
esac
